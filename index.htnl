<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Zenith Gully Cricket</title>
  <style>
    :root{--accent:#0b6efd;--bg:#0f1724;--card:#0b1220;--muted:#9aa7bf}
    *{box-sizing:border-box;font-family:Inter,Segoe UI,Arial,Helvetica,sans-serif}
    body{margin:0;background:linear-gradient(180deg,#071428 0%, #0b1220 100%);color:#e6eef8}
    header{padding:16px 20px;display:flex;align-items:center;gap:16px;background:#0b1220;position:sticky;top:0;z-index:10}
    .tabs{display:flex;gap:12px;margin-left:auto}
    .tab{padding:8px 16px;border-radius:6px;cursor:pointer;background:#111a2f;color:#ccc}
    .tab.active{background:var(--accent);color:#fff}
    main{padding:20px}
    .card{background:linear-gradient(180deg, rgba(255,255,255,0.03), rgba(255,255,255,0.02));padding:16px;border-radius:8px;border:1px solid rgba(255,255,255,0.05);margin-bottom:16px}
    h2{margin:0 0 8px 0;font-size:18px}
    table{width:100%;border-collapse:collapse;font-size:14px}
    th,td{padding:8px;border-bottom:1px solid rgba(255,255,255,0.05)}
    .grid{display:grid;gap:16px}
    .teams-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:16px}
    .team-card{background:rgba(255,255,255,0.04);border-radius:8px;padding:12px}
    .match-card{background:rgba(255,255,255,0.04);border-radius:8px;padding:12px;margin-bottom:8px}
    .controls{display:flex;gap:8px;flex-wrap:wrap}
    button{cursor:pointer;padding:8px 12px;border-radius:6px;border:none;background:var(--accent);color:#fff}
    .muted{color:var(--muted)}
    .scorebox{display:flex;gap:8px;align-items:center}
    .big{font-size:34px;font-weight:800}
    .small{font-size:13px;color:var(--muted)}
    @media (max-width:1000px){main{padding:12px}.teams-grid{grid-template-columns:repeat(2,1fr)}}
  </style>
</head>
<body>
  <header>
    <h1 style="margin:0">🏏 Zenith Gully Cricket</h1>
    <div class="tabs">
      <div class="tab active" data-tab="teams">Teams</div>
      <div class="tab" data-tab="rules">Rules</div>
      <div class="tab" data-tab="matches">Tournament</div>
      <div class="tab" data-tab="current">Current Match</div>
    </div>
  </header>

  <main>
    <section id="teamsTab">
      <div class="card">
        <h2>Teams & Players</h2>
        <div class="teams-grid" id="teamsGrid"></div>
      </div>
      <div class="card">
        <h2>Leaderboard</h2>
        <table id="leaderboard"><thead><tr><th>Team</th><th>Played</th><th>Won</th><th>Lost</th><th>Pts</th></tr></thead><tbody></tbody></table>
      </div>
    </section>

    <section id="rulesTab" style="display:none">
      <div class="card">
        <h2>Match Rules</h2>
        <ol>
          <li>No leg umpire required. Umpires to call LBW only if clear.</li>
          <li>Above shoulder = No Ball, next ball Free Hit.</li>
          <li>Foot on or before crease while bowling = legal.</li>
          <li>Batsman safe if bat grounded behind crease.</li>
          <li>Each side gets 6 overs per match (modifiable at start).</li>
          <li>Tie = Super Over (2 balls each).</li>
          <li>Fair play encouraged; umpire decision final.</li>
        </ol>
      </div>
    </section>

    <section id="matchesTab" style="display:none">
      <div class="card">
        <h2>Match Schedule & Results</h2>
        <div id="matchList"></div>
      </div>
    </section>

    <section id="currentTab" style="display:none">
      <div class="card">
        <h2>Current Match Scoring</h2>
        <div style="display:flex;gap:12px;flex-wrap:wrap;align-items:center;margin-bottom:12px">
          <label class="small">Select Match:</label>
          <select id="selectMatch"></select>
          <label class="small">Overs:</label>
          <select id="oversSelect"><option>6</option><option>8</option><option>10</option></select>
          <button id="loadMatch">Load</button>
          <button id="startMatch">Start</button>
          <button id="endMatch">End</button>
        </div>

        <div style="display:flex;gap:12px;align-items:center;margin-bottom:12px">
          <div style="flex:1">
            <div class="small">Batting</div>
            <div id="battingTeam" class="big">-</div>
            <div class="small" id="oversDisplay">Overs: 0.0</div>
          </div>
          <div style="flex:1;text-align:center">
            <div class="small">Score</div>
            <div id="scoreDisplay" class="big">0/0</div>
            <div class="small" id="runRate">RR: -</div>
          </div>
          <div style="flex:1">
            <div class="small">Opposition</div>
            <div id="oppDisplay" class="big">-</div>
            <div class="small">Status: <span id="matchStatus">Idle</span></div>
          </div>
        </div>

        <div class="controls" style="margin-bottom:12px">
          <button data-run="1">+1</button>
          <button data-run="2">+2</button>
          <button data-run="3">+3</button>
          <button data-run="4">+4</button>
          <button data-run="6">+6</button>
          <button data-run="0">Dot</button>
          <button data-run="W">W</button>
          <button data-run="NB">NB</button>
          <button data-run="LB">LB</button>
          <button id="nextBall" style="background:#444">Next Ball</button>
        </div>

        <div class="card" style="background:rgba(255,255,255,0.02)">
          <h2 style="font-size:16px;margin-bottom:8px">Score Log</h2>
          <div id="scoreLog" style="max-height:220px;overflow:auto;color:#dbe9ff;padding:8px;border-radius:6px;background:rgba(255,255,255,0.01)"></div>
        </div>

      </div>
    </section>
  </main>

  <footer class="small">Zenith Gully Cricket © 2025 — Built for Community Fun</footer>

<script>
// --- Data (initial teams & schedule) ---
const defaultTeams = [
  {id:0,name:'Zenith Strikers',players:['Amit','Ravi','Kiran','Suraj','Vijay','Anil'],stats:{played:0,won:0,lost:0,pts:0}},
  {id:1,name:'Hyd Titans',players:['Rohit','Naveen','Gautam','Lokesh','Sunny','Manish'],stats:{played:0,won:0,lost:0,pts:0}},
  {id:2,name:'Cricket Kings',players:['Rahul','Dev','Mohan','Ashok','Vivek','Harish'],stats:{played:0,won:0,lost:0,pts:0}},
  {id:3,name:'Thunder Blasters',players:['Sanjay','Pavan','Deepak','Akhil','Arjun','Dinesh'],stats:{played:0,won:0,lost:0,pts:0}},
  {id:4,name:'Street Warriors',players:['Praveen','Ravi S','Karthik','Abhishek','Naresh','Ramesh'],stats:{played:0,won:0,lost:0,pts:0}},
  {id:5,name:'Power Hitters',players:['Imran','Karan','Vicky','Suresh','Venu','Ajay'],stats:{played:0,won:0,lost:0,pts:0}}
];

const defaultMatches = [
  {id:1,teamA:0,teamB:1,time:'10:00 AM',completed:false,result:null,overs:6},
  {id:2,teamA:2,teamB:3,time:'11:00 AM',completed:false,result:null,overs:6},
  {id:3,teamA:4,teamB:5,time:'12:00 PM',completed:false,result:null,overs:6},
  {id:4,teamA:0,teamB:2,time:'1:00 PM',completed:false,result:null,overs:6},
  {id:5,teamA:1,teamB:3,time:'2:00 PM',completed:false,result:null,overs:6},
  {id:6,teamA:4,teamB:0,time:'3:00 PM',completed:false,result:null,overs:6},
  {id:7,teamA:5,teamB:2,time:'4:00 PM',completed:false,result:null,overs:6},
  {id:8,teamA:3,teamB:4,time:'5:00 PM',completed:false,result:null,overs:6},
  {id:9,teamA:1,teamB:5,time:'6:00 PM',completed:false,result:null,overs:6}
];

// --- Persistence ---
const storageKey = 'zg_state_v1';
let state = JSON.parse(localStorage.getItem(storageKey) || 'null');
if(!state){ state = {teams:defaultTeams,matches:defaultMatches,current:null}; localStorage.setItem(storageKey,JSON.stringify(state)); }

function save(){ localStorage.setItem(storageKey,JSON.stringify(state)); renderAll(); }

// --- Rendering ---
function renderTeams(){
  const grid=document.getElementById('teamsGrid'); grid.innerHTML='';
  state.teams.forEach(t=>{
    const div=document.createElement('div'); div.className='team-card';
    div.innerHTML = `<strong>${t.name}</strong><div class="small">Players:</div><ul>${t.players.map(p=>`<li>${p}</li>`).join('')}</ul>`;
    grid.appendChild(div);
  });
}

function renderMatches(){
  const list=document.getElementById('matchList'); list.innerHTML='';
  state.matches.forEach(m=>{
    const a = state.teams[m.teamA].name; const b = state.teams[m.teamB].name;
    const div=document.createElement('div'); div.className='match-card';
    div.innerHTML = `<strong>Match ${m.id}:</strong> ${a} vs ${b} — <em>${m.time}</em>
      <div class="small">Overs: ${m.overs} — Result: ${m.result?m.result:'Pending'}</div>`;
    list.appendChild(div);
  });
  // populate select
  const sel = document.getElementById('selectMatch'); sel.innerHTML='';
  state.matches.forEach(m=>{ const opt=document.createElement('option'); opt.value=m.id; opt.textContent=`Match ${m.id}: ${state.teams[m.teamA].name} vs ${state.teams[m.teamB].name}`; sel.appendChild(opt); });
}

function renderLeaderboard(){
  const tbody = document.querySelector('#leaderboard tbody'); tbody.innerHTML='';
  // sort by pts desc, won desc, name
  const teamsSorted = [...state.teams].sort((x,y)=> (y.stats.pts - x.stats.pts) || (y.stats.won - x.stats.won) || x.name.localeCompare(y.name));
  teamsSorted.forEach(t=>{
    const tr=document.createElement('tr'); tr.innerHTML = `<td>${t.name}</td><td>${t.stats.played||0}</td><td>${t.stats.won||0}</td><td>${t.stats.lost||0}</td><td>${t.stats.pts||0}</td>`; tbody.appendChild(tr);
  });
}

function renderCurrent(){
  const cm = state.current;
  const battingEl = document.getElementById('battingTeam');
  const scoreEl = document.getElementById('scoreDisplay');
  const oppEl = document.getElementById('oppDisplay');
  const oversEl = document.getElementById('oversDisplay');
  const rrEl = document.getElementById('runRate');
  const statusEl = document.getElementById('matchStatus');
  const logEl = document.getElementById('scoreLog');
  if(!cm){ battingEl.textContent='-'; scoreEl.textContent='0/0'; oppEl.textContent='-'; oversEl.textContent='Overs: 0.0'; rrEl.textContent='RR: -'; statusEl.textContent='Idle'; logEl.innerHTML='No match loaded.'; return }
  battingEl.textContent = `${state.teams[cm.batting].name} (Inn ${cm.inning})`;
  scoreEl.textContent = `${cm.score}/${cm.wkts}`;
  oppEl.textContent = `${state.teams[ cm.batting===cm.teamA? cm.teamB: cm.teamA ].name}`;
  const oversFull = Math.floor(cm.balls/6); const balls = cm.balls%6; oversEl.textContent = `Overs: ${oversFull}.${balls} / ${cm.overs}`;
  rrEl.textContent = `RR: ${cm.balls?((cm.score/(cm.balls/6)).toFixed(2)):'-'}`;
  statusEl.textContent = cm.completed? 'Finished' : 'Live';
  logEl.innerHTML = cm.log.map(it=>`<div>${it}</div>`).join('');
}

function renderAll(){ renderTeams(); renderMatches(); renderLeaderboard(); renderCurrent(); }

// --- Match control logic ---
function findMatchById(id){ return state.matches.find(m=>m.id==id); }

document.getElementById('loadMatch').addEventListener('click',()=>{
  const id = parseInt(document.getElementById('selectMatch').value,10);
  const m = findMatchById(id);
  if(!m) return alert('Select a match');
  // prepare current match object
  state.current = {
    id:m.id, teamA:m.teamA, teamB:m.teamB, batting:m.teamA, inning:1, balls:0, score:0, wkts:0, overs:m.overs, completed:false, log:[], firstInningsScore:null
  };
  save();
});

document.getElementById('startMatch').addEventListener('click',()=>{
  const overs = parseInt(document.getElementById('oversSelect').value,10);
  if(!state.current) return alert('Load a match first');
  state.current.overs = overs; save();
});

document.getElementById('endMatch').addEventListener('click',()=>{
  if(!state.current) return alert('No match loaded');
  if(!confirm('End match and record result?')) return;
  concludeMatchForced();
});

// scoring buttons
document.querySelectorAll('[data-run]').forEach(btn=>{
  btn.addEventListener('click',()=>{
    const val = btn.dataset.run; if(!state.current) return alert('Load a match first');
    const m = state.current;
    if(m.completed) return alert('Match already finished');
    if(val==='W'){ m.wkts +=1; m.balls +=1; m.log.push(`Wicket! Ball ${Math.floor(m.balls/6)}.${m.balls%6} -> ${m.score}/${m.wkts}`); }
    else if(val==='NB'){ m.score +=1; m.log.push(`No Ball (+1) -> ${m.score}/${m.wkts}`); }
    else if(val==='LB'){ m.balls +=1; m.log.push(`Leg Bye ball ${Math.floor(m.balls/6)}.${m.balls%6}`); }
    else { const runs = parseInt(val,10); if(!isNaN(runs)){ m.score += runs; m.balls +=1; m.log.push(`+${runs} runs -> ${m.score}/${m.wkts}`); } }
    // check inning end
    if(m.balls >= m.overs*6){
      if(m.inning===1){ // store first innings and switch
        m.firstInningsScore = {score:m.score,wkts:m.wkts}; m.inning=2; m.batting = (m.batting===m.teamA? m.teamB: m.teamA); m.balls=0; m.score=0; m.wkts=0; m.log.push('--- Second innings begins ---');
      } else {
        // finished
        m.completed=true; m.log.push('Innings complete'); concludeMatch();
      }
    }
    save();
  });
});

document.getElementById('nextBall').addEventListener('click',()=>{ if(!state.current) return alert('Load a match first'); const m = state.current; m.balls +=1; m.log.push(`Dot ball ${Math.floor(m.balls/6)}.${m.balls%6}`); if(m.balls>=m.overs*6){ if(m.inning===1){ m.firstInningsScore={score:m.score,wkts:m.wkts}; m.inning=2; m.batting = (m.batting===m.teamA? m.teamB: m.teamA); m.balls=0; m.score=0; m.wkts=0; m.log.push('--- Second innings begins ---'); } else { m.completed=true; m.log.push('Innings complete'); concludeMatch(); } } save(); });

function concludeMatch(){
  const m = state.current; if(!m) return;
  // determine winner
  const teamA = m.teamA, teamB = m.teamB;
  const aScore = m.firstInningsScore? m.firstInningsScore
