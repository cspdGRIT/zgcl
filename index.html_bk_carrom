<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tournament Management System</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary: #FF6B35;
            --secondary: #004E89;
            --accent: #FFC107;
            --dark: #1A1A2E;
            --light: #EAEAEA;
            --success: #4CAF50;
            --danger: #F44336;
            --pool-a: #2196F3;
            --pool-b: #9C27B0;
            --pool-c: #FF9800;
            --pool-d: #00BCD4;
        }

        body {
            font-family: 'Inter', 'Segoe UI', system-ui, -apple-system, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            color: #333;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 20px;
        }

        header {
            background: white;
            border-radius: 16px;
            padding: 30px;
            margin-bottom: 30px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
            text-align: center;
            position: relative;
        }

        .admin-link {
            position: absolute;
            top: 20px;
            right: 20px;
            padding: 8px 16px;
            background: var(--primary);
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            transition: all 0.3s;
        }

        .admin-link:hover {
            background: var(--secondary);
            transform: translateY(-2px);
        }

        h1 {
            color: var(--primary);
            font-size: 2.5em;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 15px;
        }

        .sport-icon {
            font-size: 1.2em;
        }

        .tagline {
            color: var(--secondary);
            font-size: 1.2em;
            margin-bottom: 10px;
        }

        .tournament-info-banner {
            background: linear-gradient(135deg, var(--success), #45a049);
            color: white;
            padding: 15px;
            border-radius: 12px;
            margin-top: 15px;
        }

        .nav-tabs {
            display: flex;
            gap: 10px;
            margin-bottom: 30px;
            flex-wrap: wrap;
            justify-content: center;
        }

        .tab-btn {
            padding: 12px 25px;
            background: white;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            font-size: 16px;
            font-weight: 600;
            color: var(--secondary);
            transition: all 0.3s ease;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

        .tab-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 7px 20px rgba(0,0,0,0.15);
        }

        .tab-btn.active {
            background: var(--primary);
            color: white;
        }

        .tab-content {
            display: none;
            animation: fadeIn 0.5s;
        }

        .tab-content.active {
            display: block;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .card {
            background: white;
            border-radius: 16px;
            padding: 25px;
            margin-bottom: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }

        .pool-section {
            margin-bottom: 30px;
        }

        .pool-header {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 15px;
            padding: 10px;
            border-radius: 10px;
        }

        .pool-a-header { background: linear-gradient(135deg, var(--pool-a), #1976D2); color: white; }
        .pool-b-header { background: linear-gradient(135deg, var(--pool-b), #7B1FA2); color: white; }
        .pool-c-header { background: linear-gradient(135deg, var(--pool-c), #F57C00); color: white; }
        .pool-d-header { background: linear-gradient(135deg, var(--pool-d), #0097A7); color: white; }

        .teams-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }

        .team-card {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 15px;
            padding: 20px;
            color: white;
            transition: transform 0.3s ease;
            position: relative;
        }

        .team-card:hover {
            transform: translateY(-5px);
        }

        .pool-badge {
            position: absolute;
            top: 10px;
            right: 10px;
            background: rgba(255,255,255,0.9);
            color: var(--dark);
            padding: 5px 10px;
            border-radius: 20px;
            font-weight: bold;
            font-size: 0.9em;
        }

        .team-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }

        .team-name {
            font-size: 1.5em;
            font-weight: bold;
        }

        .team-stats {
            display: flex;
            gap: 15px;
            font-size: 0.9em;
            margin-bottom: 15px;
            flex-wrap: wrap;
        }

        .player-list {
            background: rgba(255,255,255,0.1);
            border-radius: 10px;
            padding: 15px;
        }

        .player {
            padding: 5px 0;
            border-bottom: 1px solid rgba(255,255,255,0.2);
        }

        .player:last-child {
            border-bottom: none;
        }

        .captain {
            font-weight: bold;
            color: var(--accent);
        }

        .leaderboard-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        .leaderboard-table th,
        .leaderboard-table td {
            padding: 12px;
            text-align: left;
            border-bottom: 1px solid #ddd;
        }

        .leaderboard-table th {
            background: var(--secondary);
            color: white;
        }

        .leaderboard-table tr:hover {
            background: #f5f5f5;
        }

        /* Scoring System */
        .scorecard {
            background: #f5f5f5;
            border-radius: 15px;
            padding: 20px;
            margin-bottom: 20px;
        }

        .score-display {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 20px;
        }

        .score-box {
            background: white;
            border-radius: 10px;
            padding: 15px;
            text-align: center;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }

        .score-box h3 {
            color: var(--secondary);
            margin-bottom: 10px;
            font-size: 0.9em;
        }

        .score-value {
            font-size: 2.5em;
            font-weight: bold;
            color: var(--primary);
        }

        .score-label {
            font-size: 0.9em;
            color: #666;
            margin-top: 5px;
        }

        .scoring-buttons {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
            gap: 10px;
            margin: 20px 0;
        }

        .score-btn {
            padding: 15px;
            background: white;
            border: 2px solid var(--primary);
            border-radius: 10px;
            cursor: pointer;
            font-size: 16px;
            font-weight: 600;
            color: var(--primary);
            transition: all 0.3s ease;
        }

        .score-btn:hover {
            background: var(--primary);
            color: white;
            transform: scale(1.05);
        }

        .match-selector {
            margin-bottom: 20px;
        }

        .match-selector select {
            padding: 10px;
            border-radius: 5px;
            border: 2px solid var(--primary);
            font-size: 16px;
            width: 100%;
            max-width: 400px;
        }

        .btn {
            padding: 10px 20px;
            background: var(--primary);
            color: white;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-size: 16px;
            font-weight: 600;
            transition: all 0.3s ease;
            margin: 5px;
        }

        .btn:hover {
            background: #FF5722;
            transform: translateY(-2px);
        }

        .btn-success {
            background: var(--success);
        }

        .btn-success:hover {
            background: #45a049;
        }

        .btn-secondary {
            background: var(--secondary);
        }

        .btn-secondary:hover {
            background: #003A66;
        }

        .btn-danger {
            background: var(--danger);
        }

        .btn-danger:hover {
            background: #d32f2f;
        }

        .fixture-card {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px;
            background: #f9f9f9;
            border-radius: 10px;
            margin-bottom: 10px;
        }

        .fixture-teams {
            display: flex;
            align-items: center;
            gap: 20px;
            font-weight: 600;
        }

        .vs {
            color: var(--primary);
            font-weight: bold;
        }

        .fixture-info {
            text-align: right;
            color: #666;
        }

        .fixture-time {
            font-size: 0.9em;
            color: var(--secondary);
            margin-top: 5px;
        }

        .control-panel {
            background: #f0f0f0;
            border-radius: 10px;
            padding: 15px;
            margin-bottom: 20px;
        }

        .control-panel h3 {
            color: var(--secondary);
            margin-bottom: 15px;
        }

        .json-editor {
            margin: 20px 0;
        }

        .json-editor textarea {
            width: 100%;
            min-height: 400px;
            padding: 15px;
            border: 2px solid #ddd;
            border-radius: 10px;
            font-family: 'Courier New', monospace;
            font-size: 14px;
            resize: vertical;
        }

        .file-selector {
            display: flex;
            gap: 10px;
            align-items: center;
            margin-bottom: 15px;
        }

        .file-selector select {
            padding: 8px;
            border-radius: 5px;
            border: 1px solid #ddd;
            font-size: 14px;
        }

        .status-message {
            padding: 10px;
            border-radius: 5px;
            margin: 10px 0;
            display: none;
        }

        .status-message.success {
            background: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
            display: block;
        }

        .status-message.error {
            background: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
            display: block;
        }

        .generic-score-input {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 15px;
            margin: 20px 0;
        }

        .score-input-group {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .score-input-group label {
            font-size: 14px;
            font-weight: 600;
            color: var(--dark);
        }

        .score-input-group input,
        .score-input-group select {
            padding: 8px;
            border: 2px solid #ddd;
            border-radius: 6px;
            font-size: 15px;
        }

        @media (max-width: 768px) {
            .teams-grid {
                grid-template-columns: 1fr;
            }
            
            h1 {
                font-size: 1.8em;
            }
            
            .nav-tabs {
                flex-direction: column;
            }
            
            .tab-btn {
                width: 100%;
            }

            .scoring-buttons {
                grid-template-columns: repeat(3, 1fr);
            }

            .admin-link {
                position: static;
                display: inline-block;
                margin-top: 10px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <a href="admin.html" class="admin-link">⚙️ Admin Panel</a>
            <h1>
                <span class="sport-icon" id="tournament-icon">🏆</span>
                <span id="tournament-name">Tournament</span>
            </h1>
            <div class="tagline" id="tournament-tagline">Loading...</div>
            <div class="tournament-info-banner" id="info-banner" style="display: none;">
                <!-- Dynamic tournament info will be shown here -->
            </div>
        </header>

        <div class="nav-tabs">
            <button class="tab-btn active" onclick="switchTab('dashboard')">📊 Dashboard</button>
            <button class="tab-btn" onclick="switchTab('teams')">👥 Teams</button>
            <button class="tab-btn" onclick="switchTab('fixtures')">📅 Fixtures</button>
            <button class="tab-btn" onclick="switchTab('live')">🔴 Live Score</button>
            <button class="tab-btn" onclick="switchTab('statistics')">📈 Statistics</button>
            <button class="tab-btn" onclick="switchTab('json-editor')">📝 JSON Editor</button>
            <button class="tab-btn" onclick="switchTab('download')">💾 Download</button>
        </div>

        <!-- Dashboard Tab -->
        <div id="dashboard" class="tab-content active">
            <div id="standings-container">
                <!-- Pool standings will be dynamically generated here -->
            </div>

            <div class="card">
                <h2>🌟 Tournament Statistics</h2>
                <div id="tournament-stats">
                    <!-- Will be populated dynamically based on sport -->
                </div>
            </div>
        </div>

        <!-- Teams Tab -->
        <div id="teams" class="tab-content">
            <div class="card">
                <div id="teams-pools-container">
                    <!-- Teams grouped by pools will be shown here -->
                </div>
            </div>
        </div>

        <!-- Fixtures Tab -->
        <div id="fixtures" class="tab-content">
            <div class="card">
                <h2>📅 Tournament Schedule</h2>
                <div id="fixtures-list">
                    <!-- Will be populated dynamically -->
                </div>
            </div>
        </div>

        <!-- Live Score Tab -->
        <div id="live" class="tab-content">
            <div class="card">
                <h2>🔴 Live Scoring System</h2>
                
                <div class="match-selector">
                    <label for="match-select">Select Match:</label>
                    <select id="match-select" onchange="selectMatch()">
                        <option value="">Choose a match...</option>
                        <!-- Will be populated dynamically -->
                    </select>
                    <button class="btn btn-success" onclick="startMatch()">Start Match</button>
                </div>

                <div id="live-score-area" style="display: none;">
                    <div class="scorecard">
                        <h3 id="match-title">Match Title</h3>
                        
                        <div class="score-display" id="score-display">
                            <!-- Dynamic score display based on sport -->
                        </div>

                        <div class="generic-score-input" id="score-input-fields">
                            <!-- Dynamic input fields based on sport -->
                        </div>

                        <div id="sport-specific-controls">
                            <!-- Sport-specific scoring buttons/controls -->
                        </div>

                        <div style="margin-top: 20px;">
                            <button class="btn btn-success" onclick="updateScore()">Update Score</button>
                            <button class="btn btn-danger" onclick="endMatch()">End Match</button>
                            <button class="btn" onclick="saveMatch()">💾 Save Match</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Statistics Tab -->
        <div id="statistics" class="tab-content">
            <div class="card">
                <h2>📈 Tournament Statistics</h2>
                <div id="statistics-content">
                    <!-- Dynamic statistics based on sport -->
                </div>
            </div>
        </div>

        <!-- JSON Editor Tab -->
        <div id="json-editor" class="tab-content">
            <div class="card">
                <h2>📝 JSON File Editor</h2>
                
                <div class="control-panel">
                    <h3>Select JSON File to Edit</h3>
                    <div class="file-selector">
                        <select id="json-file-selector" onchange="loadJSONFile()">
                            <option value="">Select a file...</option>
                            <option value="config">config.json</option>
                            <option value="teams">teams.json</option>
                            <option value="tournament">tournament.json</option>
                            <option value="matches">matches.json</option>
                            <option value="rules">rules.json</option>
                        </select>
                        <button class="btn btn-secondary" onclick="loadJSONFile()">Load File</button>
                    </div>
                    
                    <div id="status-message" class="status-message"></div>
                    
                    <div class="json-editor">
                        <textarea id="json-editor-textarea" placeholder="Select a JSON file to edit..."></textarea>
                    </div>
                    
                    <div style="margin-top: 15px;">
                        <button class="btn btn-success" onclick="saveJSONFile()">💾 Save Changes</button>
                        <button class="btn btn-secondary" onclick="validateJSON()">✔️ Validate JSON</button>
                        <button class="btn" onclick="reloadFromJSON()">🔄 Reload Page Data</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Download Tab -->
        <div id="download" class="tab-content">
            <div class="card">
                <h2>💾 Download Data</h2>
                
                <div class="control-panel">
                    <h3>Export All Data</h3>
                    <p>Download all JSON files in a timestamped folder to preserve your data.</p>
                    
                    <button class="btn btn-success" onclick="downloadAllJSON()">
                        📦 Download All JSON Files
                    </button>
                    
                    <div style="margin-top: 20px;">
                        <h4>Individual File Downloads</h4>
                        <button class="btn btn-secondary" onclick="downloadFile('config')">Configuration</button>
                        <button class="btn btn-secondary" onclick="downloadFile('teams')">Teams</button>
                        <button class="btn btn-secondary" onclick="downloadFile('tournament')">Tournament</button>
                        <button class="btn btn-secondary" onclick="downloadFile('matches')">Matches</button>
                        <button class="btn btn-secondary" onclick="downloadFile('rules')">Rules</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="tournament-generic.js"></script>
</body>
</html>
